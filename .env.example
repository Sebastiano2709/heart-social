# Public site URL (canonical links, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.heartsocial.ro
# Indexing stays OFF until this is "true" on the production deployment
NEXT_PUBLIC_ALLOW_INDEXING=false

# Analytics — loaded only after cookie consent
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=000000000000000

# Lead form (canonical flow 05 §10.9)
DATABASE_URL=postgres://user:pass@host:5432/db       # run db/001_call_requests.sql once
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io         # shared rate-limit store; without it the form fails closed in production
UPSTASH_REDIS_REST_TOKEN=xxx
CLIENT_IP_SOURCE=vercel                               # vercel | cloudflare | xff-trusted-hops (09 §4.6)
# TRUSTED_PROXY_HOPS=1

# Lead e-mail notification (Resend)
RESEND_API_KEY=re_xxx
LEAD_NOTIFY_TO=[EMAIL]
LEAD_NOTIFY_FROM=Heart Social <site@heartsocial.ro>
